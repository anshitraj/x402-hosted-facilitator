# Local hosted facilitator alpha defaults.
# Copy this file to hosted.env before running docker-compose.yml.

OMNICLAW_X402_FACILITATOR_NETWORK_PROFILE=ARC-TESTNET
OMNICLAW_HOSTED_EXACT_ENABLED=true
OMNICLAW_HOSTED_EXACT_NETWORKS=eip155:5042002
OMNICLAW_HOSTED_EXACT_RPC_URL_EIP155_5042002=https://rpc.testnet.arc.network
OMNICLAW_HOSTED_FACILITATOR_MODE=local

# The hosted facilitator pays EVM gas from this key. Fund this address on each supported network.
OMNICLAW_X402_FACILITATOR_PRIVATE_KEY=
OMNICLAW_HOSTED_EXACT_SIGNER_PRIVATE_KEY_ENV=OMNICLAW_X402_FACILITATOR_PRIVATE_KEY
OMNICLAW_HOSTED_EXACT_SIGNER_ID=hosted-exact-alpha
OMNICLAW_HOSTED_EXACT_SIGNER_ENVIRONMENT=local
OMNICLAW_HOSTED_EXACT_SIGNER_MIN_GAS_WEI=100000000000000

# Optional Circle Gateway nanopayment provider. Keep disabled unless seller
# payment profiles are intended to advertise Gateway batched payment kinds.
OMNICLAW_HOSTED_CIRCLE_GATEWAY_ENABLED=false
OMNICLAW_HOSTED_CIRCLE_GATEWAY_ENVIRONMENT=testnet
OMNICLAW_HOSTED_CIRCLE_GATEWAY_NETWORKS=eip155:5042002
OMNICLAW_HOSTED_CIRCLE_GATEWAY_TIMEOUT_SECONDS=30

# Seller API keys are created through the operator control plane and stored in
# Postgres. Do not configure a default facilitator API key in local, staging, or
# production; startup rejects OMNICLAW_HOSTED_DEFAULT_API_KEY.

# Local Compose sends traces and metrics to the bundled collector.
# Hosted/staging/prod must keep OTEL required, JSON logs enabled, and use HTTPS collector/vendor endpoints.
OMNICLAW_HOSTED_OTEL_REQUIRED=true
OMNICLAW_HOSTED_OTEL_ALLOW_INSECURE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OMNICLAW_HOSTED_OTEL_COLLECTOR_HEALTH_URL=http://otel-collector:13133
OMNICLAW_HOSTED_JSON_LOGS=true

# Compose ops auth is configured by docker-compose.yml:
# - Keycloak runs in production server mode with Postgres storage.
# - For local development, optional .env values may override
#   OMNICLAW_POSTGRES_PASSWORD, OMNICLAW_KEYCLOAK_ADMIN_USERNAME, and
#   OMNICLAW_KEYCLOAK_ADMIN_PASSWORD.
# - Keycloak issues OIDC tokens for ops@omniclaw.ai / omniclaw-alpha-admin.
# - OpenFGA grants user:ops-alpha-admin security_admin on ops_console:default.
