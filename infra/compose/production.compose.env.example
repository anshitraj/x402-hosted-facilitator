# Docker Compose interpolation env.
# This file selects images, bind addresses, and per-service env files.
# It is not mounted into the containers.

COMPOSE_SELLER_NAME=omniclaw-hosted

OMNICLAW_HOSTED_FACILITATOR_IMAGE=ghcr.io/omnuron-labs/omniclaw-hosted-facilitator:replace-me
OMNICLAW_HOSTED_OPS_CONSOLE_IMAGE=ghcr.io/omnuron-labs/omniclaw-hosted-ops-console:replace-me

OMNICLAW_HOSTED_API_ENV_FILE=production.env.example
OMNICLAW_HOSTED_METRICS_ENV_FILE=production.metrics.env.example
OMNICLAW_OPS_ENV_FILE=production.ops.env.example

OMNICLAW_HOSTED_FACILITATOR_BIND=127.0.0.1:4022
OMNICLAW_HOSTED_METRICS_BIND=127.0.0.1:9108
OMNICLAW_OPS_BIND=127.0.0.1:3001
OMNICLAW_PROMETHEUS_BIND=127.0.0.1:9090
