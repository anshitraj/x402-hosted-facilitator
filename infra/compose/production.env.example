# Hosted facilitator API and reconciler runtime env.
# Copy to a private env file outside git and fill every placeholder before deploy.

# Runtime mode and network.
OMNICLAW_HOSTED_FACILITATOR_MODE=production
OMNICLAW_X402_FACILITATOR_NETWORK_PROFILE=ARC-TESTNET
OMNICLAW_HOSTED_EXACT_ENABLED=true
OMNICLAW_HOSTED_EXACT_NETWORKS=eip155:5042002
OMNICLAW_HOSTED_EXACT_RPC_URL_EIP155_5042002=https://replace-with-arc-rpc.example
OMNICLAW_HOSTED_EXACT_PROVIDER_TIMEOUT_SECONDS=30
OMNICLAW_HOSTED_EXACT_MAX_CONCURRENT_SETTLEMENTS=1

# Signer. Production should source the private key from a Docker secret or secret manager injector.
OMNICLAW_HOSTED_EXACT_SIGNER_PRIVATE_KEY_ENV=OMNICLAW_HOSTED_EXACT_SIGNER_PRIVATE_KEY
OMNICLAW_HOSTED_EXACT_SIGNER_PRIVATE_KEY=
OMNICLAW_HOSTED_EXACT_SIGNER_ID=hosted-exact-prod
OMNICLAW_HOSTED_EXACT_SIGNER_ENVIRONMENT=production
OMNICLAW_HOSTED_EXACT_SIGNER_STATUS=active
OMNICLAW_HOSTED_EXACT_SIGNER_MIN_GAS_WEI=100000000000000
OMNICLAW_HOSTED_EXACT_SIGNER_ADDRESS=

# Durable state. Hosted mode requires TLS Postgres DSNs and rediss.
# Control-plane and seller-account DSNs must point at the same database/user/query
# so seller policy writes and audit events commit atomically and land in the same schema.
OMNICLAW_HOSTED_FACILITATOR_POSTGRES_DSN=postgresql://user:password@postgres.example.com:5432/omniclaw_settlement?sslmode=require
OMNICLAW_HOSTED_CONTROL_PLANE_POSTGRES_DSN=postgresql://user:password@postgres.example.com:5432/omniclaw_control?sslmode=require
OMNICLAW_HOSTED_SELLER_ACCOUNTS_POSTGRES_DSN=postgresql://user:password@postgres.example.com:5432/omniclaw_control?sslmode=require
OMNICLAW_HOSTED_POSTGRES_POOL_SIZE=10
OMNICLAW_HOSTED_POSTGRES_POOL_CHECKOUT_SECONDS=2
OMNICLAW_HOSTED_API_KEY_HASH_PEPPER=replace-with-32-plus-character-random-pepper
OMNICLAW_HOSTED_RATE_LIMIT_REDIS_URL=rediss://redis.example.com:6379/0

# Operator auth. Backend authorization is OIDC + OpenFGA, not an ops token.
OMNICLAW_HOSTED_OIDC_ISSUER=https://idp.example.com/realms/omniclaw
OMNICLAW_HOSTED_OIDC_AUDIENCE=omniclaw-ops
OMNICLAW_HOSTED_OIDC_JWKS_URL=https://idp.example.com/realms/omniclaw/protocol/openid-connect/certs
OMNICLAW_HOSTED_OPENFGA_API_URL=https://openfga.example.com
OMNICLAW_HOSTED_OPENFGA_STORE_ID=
OMNICLAW_HOSTED_OPENFGA_AUTHORIZATION_MODEL_ID=

# Circle Gateway rail. Enable only after the seller account policy and canary are ready.
OMNICLAW_HOSTED_CIRCLE_GATEWAY_ENABLED=false
OMNICLAW_HOSTED_CIRCLE_GATEWAY_ENVIRONMENT=testnet
OMNICLAW_HOSTED_CIRCLE_GATEWAY_NETWORKS=eip155:5042002
OMNICLAW_HOSTED_CIRCLE_GATEWAY_TIMEOUT_SECONDS=30

# Observability.
OMNICLAW_HOSTED_OTEL_REQUIRED=true
OMNICLAW_HOSTED_JSON_LOGS=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
OMNICLAW_HOSTED_OTEL_COLLECTOR_HEALTH_URL=https://otel.example.com/health
OMNICLAW_HOSTED_RECONCILER_HEARTBEAT_PATH=/var/run/omniclaw/reconciler-heartbeat.json
OMNICLAW_HOSTED_INTERNAL_READY_ALLOW_PRIVATE_NETWORKS=true

# Reconciler.
OMNICLAW_HOSTED_RECONCILER_OWNER=hosted-reconciler-prod-1
OMNICLAW_HOSTED_RECONCILER_INTERVAL_SECONDS=30
OMNICLAW_HOSTED_RECONCILER_MAX_RUNS=
