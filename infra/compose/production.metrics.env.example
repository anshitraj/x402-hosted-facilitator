# Metrics exporter env. Do not include signer private keys or ops session secrets.

OMNICLAW_HOSTED_FACILITATOR_POSTGRES_DSN=postgresql://metrics_user:password@postgres.example.com:5432/omniclaw_settlement?sslmode=require
OMNICLAW_HOSTED_RECONCILER_HEARTBEAT_PATH=/var/run/omniclaw/reconciler-heartbeat.json
OMNICLAW_HOSTED_FACILITATOR_HEALTH_URL=http://hosted-facilitator:4022/internal/readyz
OMNICLAW_HOSTED_METRICS_PORT=9108
OMNICLAW_HOSTED_METRICS_STRICT_READY=true

OMNICLAW_HOSTED_EXACT_NETWORKS=eip155:5042002
OMNICLAW_HOSTED_EXACT_RPC_URL_EIP155_5042002=https://replace-with-arc-rpc.example
OMNICLAW_HOSTED_EXACT_SIGNER_ADDRESS=0xreplaceWithFundedHostedSignerAddress
OMNICLAW_HOSTED_EXACT_SIGNER_ID=hosted-exact-prod
OMNICLAW_HOSTED_EXACT_SIGNER_MIN_GAS_WEI=100000000000000

OMNICLAW_HOSTED_CIRCLE_GATEWAY_ENVIRONMENT=testnet
OMNICLAW_HOSTED_GATEWAY_CANARY_NETWORK=eip155:5042002
OMNICLAW_HOSTED_GATEWAY_CANARY_ADDRESS=0xreplaceWithFundedGatewayCanaryAddress
OMNICLAW_HOSTED_GATEWAY_CANARY_ID=arc-gateway-canary
OMNICLAW_HOSTED_GATEWAY_CANARY_MIN_ATOMIC=1000
OMNICLAW_HOSTED_GATEWAY_CANARY_TIMEOUT_SECONDS=5
