{
  "name": "@omniclaw/ops-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "OMNICLAW_OPS_E2E_MANAGED_SERVER=true OMNICLAW_OPS_E2E_BASE_URL=http://127.0.0.1:3101 playwright test e2e/reconciliation-ui.spec.ts --project=chromium",
    "validate:runtime": "node --import tsx scripts/validate-runtime-env.ts"
  },
  "dependencies": {
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.20.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
